# 构建产物
bin/
obj/
*.user
*.suo
.vs/

# 本地源码快照。Backups/ 里是每次动工前存的副本，
# 只对本机有意义，而且会随时间堆到几十 MB。
Backups/

# 旧的本地分发包副本。正式分发走清单仓库
# （Adzuki-hd/ADOFAIEditorStudio-manifest），这里不需要留。
dist/

# 调试与安装过程留下的日志
*.log
install-result.log

# 隔离的帧缓存实验有自己的构建产物
FrameCacheSpike/bin/
FrameCacheSpike/obj/

# 谱面工程文件，属于用户数据不属于源码
*.adofaiprj
*.adofaiprj.bak
*.adofai

# 系统
Thumbs.db
desktop.ini
.DS_Store

# Claude Code 本机设置（hook 等），不进仓库
.claude/settings.local.json

# 设计技能插件的载荷（设计 token 定义、审计脚本）。属于本机工具链，
# 和这个 mod 的源码无关，放进来只会让仓库里多出一堆没人维护的文件。
.claude/rules/
.claude/scripts/

# 工具的输出图（布局预览、图标自检），是产物不是源码
tools/layout-preview/*.png
tools/icons/selftest.png

